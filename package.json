{
  "name": "real-shadows",
  "version": "1.1.0",
  "description": "shadows that follow the real sun. computes the sun's (or at night, the moon's) actual position for a location and drives your css shadows to match. zero dependencies.",
  "keywords": [
    "shadow",
    "shadows",
    "sun",
    "moon",
    "sunlight",
    "moonlight",
    "solar",
    "ephemeris",
    "astronomy",
    "css",
    "css-variables",
    "custom-properties",
    "daylight",
    "golden-hour",
    "twilight",
    "sundial",
    "geolocation",
    "ambient",
    "zero-dependency"
  ],
  "license": "MIT",
  "author": "zayd khan (https://zayd.wtf)",
  "homepage": "https://github.com/zaydiscold/real-shadows#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaydiscold/real-shadows.git"
  },
  "bugs": {
    "url": "https://github.com/zaydiscold/real-shadows/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/real-shadows.global.js",
  "jsdelivr": "./dist/real-shadows.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "real-shadows": "./dist/cli.js"
  },
  "funding": "https://github.com/sponsors/zaydiscold",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "npm run build && node scripts/size.mjs",
    "demo": "npm run build && node scripts/serve-demo.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "astronomy-engine": "^2.1.19",
    "happy-dom": "^20.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
